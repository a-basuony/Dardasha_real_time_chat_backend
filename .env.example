# Copy to .env for LOCAL development; never commit .env with real credentials.
PORT=5001
NODE_ENV=development

# Local MongoDB example. Use your own Atlas connection string in .env if needed.
MONGO_URI=mongodb://127.0.0.1:27017/dardasha

# The application currently reads the STEAM_* names from src/lib/stream.js.
# These refer to Stream Chat credentials; the secret must stay server-side.
STEAM_API_KEY=your_stream_api_key
STEAM_API_SECRET=your_stream_api_secret

JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_32_chars

# Optional: additional explicit browser origins (comma-separated, no trailing slash).
# The known Dardasha production frontend and http://localhost:5173 are allowed by default.
CORS_ALLOWED_ORIGINS=
